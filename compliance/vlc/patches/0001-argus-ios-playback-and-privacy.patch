diff --git a/contrib/src/gcrypt/0009-argus-apple-system-random.patch b/contrib/src/gcrypt/0009-argus-apple-system-random.patch
new file mode 100644
index 0000000..baeb9a6
--- /dev/null
+++ b/contrib/src/gcrypt/0009-argus-apple-system-random.patch
@@ -0,0 +1,17 @@
+--- a/random/rndgetentropy.c
++++ b/random/rndgetentropy.c
+@@ -102,7 +102,14 @@
+ #endif
+             {
+               nbytes = length < sizeof (buffer) ? length : sizeof (buffer);
++#if defined(__APPLE__)
++              /* Argus iOS, 2026-10-05: public Apple cryptographic system RNG.
++               * Avoid device-file metadata queries in the legacy backend. */
++              arc4random_buf (buffer, nbytes);
++              ret = 0;
++#else
+               ret = getentropy (buffer, nbytes);
++#endif
+             }
+           _gcry_post_syscall ();
+         }
