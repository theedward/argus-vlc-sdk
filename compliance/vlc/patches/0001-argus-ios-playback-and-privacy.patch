diff --git a/contrib/src/ffmpeg/0001-argus-apple-entropy.patch b/contrib/src/ffmpeg/0001-argus-apple-entropy.patch
new file mode 100644
index 0000000..36aec0d
--- /dev/null
+++ b/contrib/src/ffmpeg/0001-argus-apple-entropy.patch
@@ -0,0 +1,33 @@
+--- a/libavutil/random_seed.c
++++ b/libavutil/random_seed.c
+@@ -19,6 +19,9 @@
+  */
+ 
+ #include "config.h"
++#ifdef __APPLE__
++#include <stdlib.h>
++#endif
+ 
+ #if HAVE_UNISTD_H
+ #include <unistd.h>
+@@ -74,6 +77,12 @@
+ 
+ static uint32_t get_generic_seed(void)
+ {
++#ifdef __APPLE__
++    /* Argus iOS, 2026-10-05: entropy is not a use of the timing API. */
++    uint32_t seed;
++    arc4random_buf(&seed, sizeof(seed));
++    return seed;
++#else
+     uint64_t tmp[120/8];
+     struct AVSHA *sha = (void*)tmp;
+     clock_t last_t  = 0;
+@@ -154,6 +163,7 @@
+     av_sha_update(sha, (const uint8_t *)buffer, sizeof(buffer));
+     av_sha_final(sha, digest);
+     return AV_RB32(digest) + AV_RB32(digest + 16);
++#endif
+ }
+ 
+ int av_random_bytes(uint8_t* buf, size_t len)
