diff --git a/modules/video_output/apple/VLCDrawable.h b/modules/video_output/apple/VLCDrawable.h
index 0b0b6ee..e2c8a8d 100644
--- a/modules/video_output/apple/VLCDrawable.h
+++ b/modules/video_output/apple/VLCDrawable.h
@@ -83,6 +83,12 @@
 
 /// Must be called each time media info is updated or playback state has changed
 - (void)invalidatePlaybackState;
+
+@optional
+/// Argus extension: update automatic inline-to-background PiP without replacing
+/// the decoder or drawable. Call on the main thread for immediate application.
+/// Does not start/stop PiP; disabling entry leaves an existing window unchanged.
+- (void)setAutomaticPictureInPictureEnabled:(BOOL)enabled;
 @end
 
 /**
diff --git a/modules/video_output/apple/VLCPictureInPictureController.m b/modules/video_output/apple/VLCPictureInPictureController.m
index ff3b7f9..0c1aa7c 100644
--- a/modules/video_output/apple/VLCPictureInPictureController.m
+++ b/modules/video_output/apple/VLCPictureInPictureController.m
@@ -115,11 +115,31 @@ - (void)prepare:(AVSampleBufferDisplayLayer *)layer {
     _drawable.pictureInPictureReady(self);
 }
 
+// Modified by Argus, 2026-10-07: public runtime automatic PiP policy update.
+- (void)setAutomaticPictureInPictureEnabled:(BOOL)enabled {
+#if TARGET_OS_IOS
+    void (^applyPolicy)(void) = ^{
+        // Fetch the live controller on main, so a queued update after close is
+        // a no-op rather than re-enabling a detached controller.
+        AVPictureInPictureController *controller =
+            (AVPictureInPictureController *)self->_avPipController;
+        controller.canStartPictureInPictureAutomaticallyFromInline = enabled;
+    };
+    if ([NSThread isMainThread])
+        applyPolicy();
+    else
+        dispatch_async(dispatch_get_main_queue(), applyPolicy);
+#endif
+}
+
 - (void)close {
     AVPictureInPictureController *avPipController =
         (AVPictureInPictureController *)_avPipController;
     NSObject *observer = self;
     dispatch_async(dispatch_get_main_queue(),^{
+#if TARGET_OS_IOS
+        avPipController.canStartPictureInPictureAutomaticallyFromInline = NO;
+#endif
         avPipController.contentSource = nil;
         [avPipController removeObserver:observer forKeyPath:@"isPictureInPicturePossible"];
     });
